# =============================================================================
# SIFAU — Variáveis de ambiente
# =============================================================================
# Copie este arquivo como .env e preencha com os valores do seu projeto Supabase.
# Nunca commite o arquivo .env — ele está no .gitignore.

# -----------------------------------------------------------------------------
# Supabase (obrigatório)
# -----------------------------------------------------------------------------
# URL do seu projeto Supabase (ex: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anônima (pública) do seu projeto Supabase
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-aqui

# -----------------------------------------------------------------------------
# Google Gemini API (opcional)
# -----------------------------------------------------------------------------
# Chave da API do Google Gemini para classificação automática de ocorrências.
# Se não configurada, o sistema usa classificação heurística local (funcional).
# Obtenha em: https://makersuite.google.com/app/apikey
# Esta variável é usada pela Edge Function do Supabase (não pelo frontend).
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Mapbox (opcional)
# -----------------------------------------------------------------------------
# Token público do Mapbox para exibir mapas interativos com heatmap.
# Se não configurado, o app usa o componente de mapa SVG interno.
# Obtenha em: https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=
